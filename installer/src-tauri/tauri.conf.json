{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeleCloud Setup",
  "version": "1.0.0",
  "identifier": "com.telecloud.installer",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TeleCloud Setup",
        "width": 640,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
